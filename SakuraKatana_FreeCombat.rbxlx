ies><Properties><Vector3 name="Size">10, 8, 10</Vector3></Properties><Properties><CoordinateFrame name="CFrame">{"position":{"x":72,"y":12,"z":-131},"orientation":{"x":0,"y":0,"z":0}}</CoordinateFrame></Properties><Properties><Color3 name="Color">0.12, 0.32, 0.18</Color3></Properties><Properties><token name="Material">Grass</token></Properties><Properties><float name="Transparency">0</float></Properties></Item></Item><Item class="Model" referent="RBX_425692384744886278"><Properties><string name="Name">Flora_41</string></Properties><Item class="Part" referent="RBX_426127781278870681"><Properties><string name="Name">Trunk</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="CanCollide">true</bool></Properties><Properties><Vector3 name="Size">2, 10, 2</Vector3></Properties><Properties><CoordinateFrame name="CFrame">{"position":{"x":-72,"y":5,"z":-75},"orientation":{"x":0,"y":0,"z":0}}</CoordinateFrame></Properties><Properties><Color3 name="Color">0.38, 0.2, 0.1</Color3></Properties><Properties><token name="Material">Wood</token></Properties><Properties><float name="Transparency">0</float></Properties></Item><Item class="Part" referent="RBX_6869974154936017602"><Properties><string name="Name">Canopy</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="CanCollide">true</bool></Properties><Properties><Vector3 name="Size">10, 8, 10</Vector3></Properties><Properties><CoordinateFrame name="CFrame">{"position":{"x":-72,"y":12,"z":-75},"orientation":{"x":0,"y":0,"z":0}}</CoordinateFrame></Properties><Properties><Color3 name="Color">0.08, 0.26, 0.12</Color3></Properties><Properties><token name="Material">Grass</token></Properties><Properties><float name="Transparency">0</float></Properties></Item></Item></Item><Item class="Folder" referent="RBX_4581207263093390127"><Properties><string name="Name">SpawnPoints</string></Properties><Item class="SpawnLocation" referent="RBX_3232044874569732762"><Properties><string name="Name">Spawn_0</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="Neutral">true</bool></Properties><Properties><Vector3 name="Size">8, 1, 8</Vector3></Properties><Properties><Vector3 name="Position">-70, 2, 0</Vector3></Properties><Properties><float name="Transparency">1</float></Properties></Item><Item class="SpawnLocation" referent="RBX_3762517654902161868"><Properties><string name="Name">Spawn_1</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="Neutral">true</bool></Properties><Properties><Vector3 name="Size">8, 1, 8</Vector3></Properties><Properties><Vector3 name="Position">70, 2, 0</Vector3></Properties><Properties><float name="Transparency">1</float></Properties></Item><Item class="SpawnLocation" referent="RBX_4190452859853739092"><Properties><string name="Name">Spawn_2</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="Neutral">true</bool></Properties><Properties><Vector3 name="Size">8, 1, 8</Vector3></Properties><Properties><Vector3 name="Position">0, 2, 190</Vector3></Properties><Properties><float name="Transparency">1</float></Properties></Item><Item class="SpawnLocation" referent="RBX_4155228437528022109"><Properties><string name="Name">Spawn_3</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="Neutral">true</bool></Properties><Properties><Vector3 name="Size">8, 1, 8</Vector3></Properties><Properties><Vector3 name="Position">0, 2, -190</Vector3></Properties><Properties><float name="Transparency">1</float></Properties></Item><Item class="SpawnLocation" referent="RBX_6508187038530834391"><Properties><string name="Name">Spawn_4</string></Properties><Properties><bool name="Anchored">true</bool></Properties><Properties><bool name="Neutral">true</bool></Properties><Properties><Vector3 name="Size">8, 1, 8</Vector3></Properties><Properties><Vector3 name="Position">0, 2, 0</Vector3></Properties><Properties><float name="Transparency">1</float></Properties></Item></Item></Item><Item class="Lighting" referent="RBX_8188768702517832844"><Properties><string name="Name">Lighting</string></Properties><Properties><token name="Technology">Future</token></Properties><Properties><float name="Brightness">2</float></Properties><Properties><float name="ClockTime">17.2</float></Properties><Properties><Color3 name="Ambient">0.25, 0.22, 0.20</Color3></Properties><Properties><Color3 name="OutdoorAmbient">0.42, 0.32, 0.28</Color3></Properties><Properties><bool name="GlobalShadows">true</bool></Properties><Item class="Atmosphere" referent="RBX_7043700453367306818"><Properties><string name="Name">SakuraMist</string></Properties><Properties><float name="Density">0.28</float></Properties><Properties><float name="Offset">0.25</float></Properties><Properties><Color3 name="Color">0.72, 0.68, 0.62</Color3></Properties><Properties><Color3 name="Decay">0.32, 0.25, 0.25</Color3></Properties><Properties><float name="Haze">1.6</float></Properties><Properties><float name="Glare">0.12</float></Properties></Item></Item><Item class="ReplicatedStorage" referent="RBX_3455398265925593091"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX_83632200439355997"><Properties><string name="Name">KatanaRemotes</string></Properties><Item class="RemoteEvent" referent="RBX_461496392141408996"><Properties><string name="Name">Action</string></Properties></Item><Item class="RemoteEvent" referent="RBX_2184585046303259700"><Properties><string name="Name">State</string></Properties></Item><Item class="RemoteEvent" referent="RBX_4548763327270372900"><Properties><string name="Name">FX</string></Properties></Item></Item><Item class="Folder" referent="RBX_2999897315620814649"><Properties><string name="Name">KatanaConfig</string></Properties><Item class="ModuleScript" referent="RBX_7531115650738733475"><Properties><string name="Name">CombatConfig</string></Properties><Properties><ProtectedString name="Source">local Config = {}
Config.MaxHealth = 100
Config.MaxStamina = 200
Config.AttackDamage = 22
Config.RiposteDamage = 34
Config.BlockCost = 20
Config.AttackCost = 12
Config.AttackCooldown = 0.52
Config.AttackRange = 10
Config.AttackArc = 0.72
Config.ParryWindow = 0.22
Config.ParryCooldown = 0.8
Config.RiposteWindow = 3.2
Config.BleedWindow = 5
Config.RespawnDelay = 4
Config.AttackVariants = {"DiagonalRight","HorizontalLeft","VerticalRise","DiagonalLeft","Thrust","HorizontalRight","LowSweep","Overhead"}
Config.BlockReactions = {"GuardImpact1","GuardImpact2","GuardImpact3","GuardImpact4","GuardImpact5","GuardImpact6","GuardImpact7","GuardImpact8"}
return Config</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX_241473164560153290"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX_5725191658898425849"><Properties><string name="Name">CombatServer</string></Properties><Properties><ProtectedString name="Source">local Players=game:GetService("Players")
local Rep=game:GetService("ReplicatedStorage")
local Config=require(Rep.KatanaConfig.CombatConfig)
local R=Rep.KatanaRemotes
local state={}
local function now() return os.clock() end
local function getChar(p) return p.Character end
local function hum(p) local c=getChar(p); return c and c:FindFirstChildOfClass("Humanoid") end
local function root(p) local c=getChar(p); return c and c:FindFirstChild("HumanoidRootPart") end
local function send(p,kind,data) R.State:FireClient(p,kind,data) end
local function reset(p) state[p]={stamina=Config.MaxStamina,drawn=false,blocking=false,nextAttack=0,attackIndex=1,blockIndex=1,parryUntil=0,parryReady=false,riposteTarget=nil,riposteUntil=0,bleed=false,dead=false,lastHit={}} end
local function ensure(p) if not state[p] then reset(p) end return state[p] end
local function spend(p,n) local s=ensure(p); if s.stamina&lt;n then return false end; s.stamina=math.max(0,s.stamina-n); send(p,"Stamina",s.stamina); return true end
local function damage(attacker,target,amount,source)
 local h=hum(target); if not h or h.Health&lt;=0 then return end
 local ts=ensure(target); if ts.dead then return end
 h:TakeDamage(amount); send(target,"Hit",{amount=amount,source=source})
 if h.Health&lt;=0 then
  ts.dead=true; local ls=attacker and attacker:FindFirstChild("leaderstats"); if ls and ls:FindFirstChild("Eliminations") then ls.Eliminations.Value+=1 end
 end
end
local function validPair(a,b) local ar=root(a); local br=root(b); if not ar or not br then return false end; local d=br.Position-ar.Position; return d.Magnitude&lt;=Config.AttackRange and ar.CFrame.LookVector:Dot(d.Unit)&gt;=Config.AttackArc end
local function findTarget(p)
 local best=nil; for _,q in Players:GetPlayers() do if q~=p and hum(q) and hum(q).Health&gt;0 and validPair(p,q) then best=q; break end end; return best end
R.Action.OnServerEvent:Connect(function(p,action,data)
 local s=ensure(p); local h=hum(p); if not h or h.Health&lt;=0 or s.dead then return end
 local t=now()
 if action=="ToggleDraw" then s.drawn=not s.drawn; s.blocking=false; send(p,"Drawn",s.drawn); return end
 if action=="BlockBegin" then if s.drawn and s.stamina&gt;0 then s.blocking=true; s.parryUntil=t+Config.ParryWindow; s.parryReady=true; send(p,"Blocking",true) end; return end
 if action=="BlockEnd" then s.blocking=false; s.parryReady=false; send(p,"Blocking",false); return end
 if action=="Attack" then
  if not s.drawn or s.blocking or t&lt;s.nextAttack or not spend(p,Config.AttackCost) then return end
  s.nextAttack=t+Config.AttackCooldown; local variant=Config.AttackVariants[s.attackIndex]; s.attackIndex=s.attackIndex%#Config.AttackVariants+1; send(p,"Attack",variant)
  local target=findTarget(p); if not target then return end; local ts=ensure(target)
  if ts.blocking then
   if ts.parryReady and t&lt;=ts.parryUntil then
    ts.parryReady=false; ts.parryUntil=0; ts.riposteTarget=p; ts.riposteUntil=t+Config.RiposteWindow; local ls=target:FindFirstChild("leaderstats"); if ls then ls.PerfectParries.Value+=1 end; send(target,"PerfectParry",true); send(p,"Parried",true)
   elseif spend(target,Config.BlockCost) and spend(p,Config.BlockCost) then
    ts.blockIndex=ts.blockIndex%#Config.BlockReactions+1; send(target,"BlockImpact",Config.BlockReactions[ts.blockIndex]); send(p,"Blocked",true)
   else ts.blocking=false; damage(p,target,Config.AttackDamage,"guard_break") end
  else damage(p,target,Config.AttackDamage,"slash") end
  return
 end
 if action=="Riposte" then
  local target=s.riposteTarget; if target and t&lt;=s.riposteUntil and validPair(p,target) and spend(p,Config.AttackCost) then
   local ts=ensure(target); ts.riposteCount=(ts.riposteCount or 0)+1; s.riposteTarget=nil; send(p,"Riposte",ts.riposteCount); damage(p,target,Config.RiposteDamage,"riposte")
   if ts.riposteCount&gt;=3 then ts.bleed=true; ts.bleedEnd=t+Config.BleedWindow; ts.executeBy=p; ts.riposteCount=0; send(target,"BleedOut",{by=p.Name,duration=Config.BleedWindow}); send(p,"ExecutionReady",target.UserId) end
  end
  return
 end
 if action=="Execute" then
  for q,qs in pairs(state) do if q.UserId==data and qs.bleed and t&lt;=qs.bleedEnd and qs.executeBy==p then qs.dead=true; qs.bleed=false; local hh=hum(q); if hh then hh.Health=0 end; local ls=p:FindFirstChild("leaderstats"); if ls then ls.Eliminations.Value+=1 end; send(p,"Executed",true); return end end
 end
end)
Players.PlayerAdded:Connect(function(p)
 reset(p); local ls=Instance.new("Folder"); ls.Name="leaderstats"; ls.Parent=p
 for _,n in {"Eliminations","Deaths","PerfectParries"} do local v=Instance.new("IntValue"); v.Name=n; v.Value=0; v.Parent=ls end
 p.CharacterAdded:Connect(function(c) local s=ensure(p); s.dead=false; s.bleed=false; s.riposteTarget=nil; s.stamina=Config.MaxStamina; local h=c:WaitForChild("Humanoid"); h.MaxHealth=Config.MaxHealth; h.Health=Config.MaxHealth; h.Died:Connect(function() if not s.dead then s.dead=true; p.leaderstats.Deaths.Value+=1 end; task.delay(Config.RespawnDelay,function() if p.Parent then p:LoadCharacter() end end) end); send(p,"Init",{health=Config.MaxHealth,stamina=Config.MaxStamina}) end)
end)
Players.PlayerRemoving:Connect(function(p) state[p]=nil end)
task.spawn(function() while true do task.wait(0.2); for p,s in pairs(state) do if p.Parent and not s.blocking and not s.dead then s.stamina=math.min(Config.MaxStamina,s.stamina+4); send(p,"Stamina",s.stamina) end end end end)</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX_361470263262941909"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX_4331589529697149015"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX_4799180980937749217"><Properties><string name="Name">CombatClient</string></Properties><Properties><ProtectedString name="Source">local Players=game:GetService("Players")
local UIS=game:GetService("UserInputService")
local Rep=game:GetService("ReplicatedStorage")
local p=Players.LocalPlayer; local R=Rep.KatanaRemotes; local drawn=false; local blocking=false
local gui=Instance.new("ScreenGui"); gui.Name="KatanaHUD"; gui.ResetOnSpawn=false; gui.Parent=p:WaitForChild("PlayerGui")
local function label(txt,pos,size,color) local l=Instance.new("TextLabel"); l.Text=txt; l.Position=pos; l.Size=size; l.BackgroundTransparency=1; l.TextColor3=color; l.Font=Enum.Font.Garamond; l.TextSize=18; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=gui; return l end
local hp=label("HP 100 / 100",UDim2.new(0,24,1,-110),UDim2.new(0,240,0,24),Color3.fromRGB(240,220,190)); local st=label("ENDURANCE 200 / 200",UDim2.new(0,24,1,-80),UDim2.new(0,260,0,24),Color3.fromRGB(170,220,190)); local sword=label("KATANA  •  SHEATHED",UDim2.new(1,-280,1,-90),UDim2.new(0,260,0,24),Color3.fromRGB(240,220,190)); sword.TextXAlignment=Enum.TextXAlignment.Right
local hint=label("LMB attack   RMB block / perfect parry   Q draw/sheath   E riposte",UDim2.new(0.5,-260,1,-38),UDim2.new(0,520,0,22),Color3.fromRGB(190,180,160)); hint.TextXAlignment=Enum.TextXAlignment.Center
local banner=label("",UDim2.new(.5,-200,.22,0),UDim2.new(0,400,0,42),Color3.fromRGB(255,225,150)); banner.TextXAlignment=Enum.TextXAlignment.Center; banner.TextSize=28
local exec=Instance.new("TextButton"); exec.Text="EXECUTE"; exec.Size=UDim2.new(0,180,0,48); exec.Position=UDim2.new(.5,-90,.68,0); exec.Visible=false; exec.BackgroundColor3=Color3.fromRGB(100,30,26); exec.TextColor3=Color3.fromRGB(255,235,205); exec.Font=Enum.Font.Garamond; exec.TextSize=22; exec.Parent=gui
local function flash(t) banner.Text=t; task.delay(1.1,function() if banner.Text==t then banner.Text="" end end) end
UIS.InputBegan:Connect(function(i,g) if g then return end; if i.KeyCode==Enum.KeyCode.Q then R.Action:FireServer("ToggleDraw") elseif i.UserInputType==Enum.UserInputType.MouseButton1 then R.Action:FireServer("Attack") elseif i.UserInputType==Enum.UserInputType.MouseButton2 then blocking=true; R.Action:FireServer("BlockBegin") elseif i.KeyCode==Enum.KeyCode.E then R.Action:FireServer("Riposte") end end)
UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton2 then blocking=false; R.Action:FireServer("BlockEnd") end end)
R.State.OnClientEvent:Connect(function(k,d) if k=="Init" then hp.Text="HP 100 / 100"; st.Text="ENDURANCE 200 / 200" elseif k=="Stamina" then st.Text=string.format("ENDURANCE %d / 200",d) elseif k=="Drawn" then drawn=d; sword.Text=d and "KATANA  •  DRAWN" or "KATANA  •  SHEATHED" elseif k=="Blocking" then sword.Text=d and "KATANA  •  GUARD" or (drawn and "KATANA  •  DRAWN" or "KATANA  •  SHEATHED") elseif k=="PerfectParry" then flash("PERFECT PARRY") elseif k=="Parried" then flash("ATTACK DEFLECTED") elseif k=="Blocked" then flash("BLOCKED") elseif k=="BleedOut" then flash("FATAL BLEED • EXECUTION WINDOW"); exec.Visible=true elseif k=="Executed" then exec.Visible=false; flash("EXECUTION") elseif k=="Hit" then flash("-"..d.amount) end end)
exec.MouseButton1Click:Connect(function() R.Action:FireServer("Execute") end)</ProtectedString></Properties></Item></Item></Item><Item class="StarterGui" referent="RBX_1150755203219945142"><Properties><string name="Name">StarterGui</string></Properties></Item></roblox>